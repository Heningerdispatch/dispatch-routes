rules_version = '2';
// Dispatch Routes: who may read and write what.
// Paste this whole file into Firebase console > Firestore > Rules, then click Publish.
// OWNER_UIDS: the office login(s) created on setup.html. They are always admins.
service cloud.firestore {
  match /databases/{database}/documents {

    function owners() { return ['REPLACE_WITH_OWNER_UID']; }
    function signedIn() { return request.auth != null; }
    function idPath() { return /databases/$(database)/documents/uids/$(request.auth.uid); }
    function hasId() { return signedIn() && exists(idPath()); }
    function ident() { return get(idPath()).data; }
    function isOwner() { return signedIn() && request.auth.uid in owners(); }
    function isAdmin() { return isOwner() || (hasId() && ident().active == true && ident().role == 'admin'); }
    function isCrew() { return isAdmin() || (hasId() && ident().active == true); }
    function me() { return ident().personId; }
    function evDoc(e) { return get(/databases/$(database)/documents/events/$(e)).data; }
    // A crew may only log visits on a route that's part of a snow event that's running now.
    function routeRunning(e, r) { return exists(/databases/$(database)/documents/events/$(e)) && evDoc(e).active == true && r in evDoc(e).routes; }

    // Names on the sign-in screen (no PINs, no contact details).
    match /roster/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sign-in -> person mapping. Each person may read their own; only admins write.
    match /uids/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /people/{id} {
      allow read: if isCrew();
      allow write: if isAdmin();
    }

    match /sites/{id} {
      allow read: if isCrew();
      allow write: if isAdmin();
    }

    match /routes/{id} {
      allow read: if isCrew();
      allow write: if isAdmin();
    }

    match /meta/{id} {
      allow read: if isCrew();
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if isCrew();
      allow write: if isAdmin();
    }

    // Site visits. Crews may start a visit for the running snow event, tick it off and complete it,
    // or cancel a visit they started by mistake. Once done or cancelled, only admins can change or delete it.
    match /visits/{id} {
      allow read: if isCrew();
      allow delete: if isAdmin();
      allow create: if isAdmin() || (isCrew()
        && request.resource.data.status == 'open'
        && request.resource.data.startBy == me()
        && routeRunning(request.resource.data.eventId, request.resource.data.routeId)
        && request.resource.data.keys().hasOnly(['eventId', 'routeId', 'siteId', 'n', 'status', 'crew', 'startMs', 'startSrv', 'startBy', 'startGeo', 'addrTicks', 'nfMs']));
      allow update: if isAdmin() || (isCrew()
        && resource.data.status == 'open'
        && request.resource.data.status in ['open', 'done', 'cancelled']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'crew', 'addrTicks', 'nfMs', 'endMs', 'endSrv', 'endBy', 'endGeo'])
        && (request.resource.data.status == 'open' || request.resource.data.endBy == me()));
    }
  }
}
